<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Generador Universal de Retos y Simuladores Académicos</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', sans-serif;
    }
    .fade-in {
      animation: fadeIn 0.25s ease-in-out;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

  <!-- BARRA SUPERIOR INSTITUCIONAL -->
  <header class="bg-slate-900 text-white border-b border-slate-800 sticky top-0 z-30 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex flex-col md:flex-row md:items-center md:justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-indigo-600 flex items-center justify-center text-white shadow-inner shrink-0">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        </div>
        <div>
          <h1 class="text-base sm:text-lg font-extrabold tracking-tight leading-tight">
            Generador Universal de Retos y Simuladores Académicos
          </h1>
          <p class="text-xs text-slate-400">
            Motor multidisciplinario para convertir cualquier gránulo temático en experiencias interactivas
          </p>
        </div>
      </div>

      <!-- NAVEGACIÓN DE PESTAÑAS -->
      <nav class="flex items-center bg-slate-800/90 p-1 rounded-xl border border-slate-700 self-start md:self-auto">
        <button id="tab-btn-docente" onclick="cambiarVista('docente')"
          class="flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs sm:text-sm font-semibold transition bg-indigo-600 text-white shadow-sm">
          <span>1. Gránulo Temático</span>
        </button>

        <button id="tab-btn-estudiante" onclick="cambiarVista('estudiante')" disabled
          class="flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs sm:text-sm font-semibold transition text-slate-400 opacity-50 cursor-not-allowed">
          <span>2. Simulador Interactivo</span>
        </button>

        <button id="tab-btn-ficha" onclick="cambiarVista('ficha')" disabled
          class="flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs sm:text-sm font-semibold transition text-slate-400 opacity-50 cursor-not-allowed">
          <span>3. Ficha y Exportación</span>
        </button>
      </nav>
    </div>
  </header>

  <!-- CONTENEDOR DE MENSAJES DE NOTIFICACIÓN (SIN ALERT) -->
  <div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

  <!-- CONTENIDO PRINCIPAL -->
  <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <!-- =================================================================== -->
    <!-- VISTA 1: GRÁNULO TEMÁTICO (ENTRADA DEL DOCENTE - 100% EN BLANCO)    -->
    <!-- =================================================================== -->
    <section id="vista-docente" class="fade-in grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- Formulario Principal -->
      <div class="lg:col-span-8 bg-white rounded-2xl shadow-sm border border-slate-200 p-6 sm:p-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 mb-6 border-b border-slate-100">
          <div>
            <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-indigo-700 bg-indigo-50 px-2.5 py-1 rounded-md mb-1.5">
              Diseño Instruccional Agnóstico
            </span>
            <h2 class="text-xl sm:text-2xl font-bold text-slate-900">Ingresar Gránulo de la Semana</h2>
          </div>

          <div class="flex items-center gap-2">
            <button type="button" onclick="limpiarFormulario()"
              class="text-xs font-semibold text-slate-600 hover:text-slate-900 bg-slate-100 hover:bg-slate-200 px-3 py-2 rounded-lg transition">
              Limpiar campos
            </button>
          </div>
        </div>

        <!-- Barra de Ejemplos Multidisciplinarios Opcionales -->
        <div class="mb-6 p-3.5 rounded-xl bg-slate-50 border border-slate-200/80 flex flex-wrap items-center justify-between gap-2">
          <span class="text-xs font-semibold text-slate-600">
            ¿Deseas probar la versatilidad? Cargar muestra de otra facultad:
          </span>
          <div class="flex flex-wrap gap-2">
            <button type="button" onclick="cargarMuestra('salud')"
              class="text-xs font-semibold px-2.5 py-1.5 rounded-lg bg-white border border-slate-300 text-slate-700 hover:border-emerald-500 hover:text-emerald-700 transition shadow-2xs">
              + Salud / Enfermería
            </button>
            <button type="button" onclick="cargarMuestra('derecho')"
              class="text-xs font-semibold px-2.5 py-1.5 rounded-lg bg-white border border-slate-300 text-slate-700 hover:border-indigo-500 hover:text-indigo-700 transition shadow-2xs">
              + Derecho Penal
            </button>
            <button type="button" onclick="cargarMuestra('ingenieria')"
              class="text-xs font-semibold px-2.5 py-1.5 rounded-lg bg-white border border-slate-300 text-slate-700 hover:border-sky-500 hover:text-sky-700 transition shadow-2xs">
              + Ingeniería / Software
            </button>
          </div>
        </div>

        <!-- Alerta de Validación / Error -->
        <div id="error-box" class="hidden mb-6 p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-start gap-3">
          <svg class="w-5 h-5 text-rose-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <p id="error-text"></p>
        </div>

        <form id="form-granulo" onsubmit="generarActividad(event)" class="space-y-5">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="sm:col-span-2">
              <label for="input-asignatura" class="block text-sm font-semibold text-slate-700 mb-1.5">
                Nombre de la Asignatura *
              </label>
              <input id="input-asignatura" type="text" required
                placeholder="Ej: Derecho Constitucional / Biología Celular / Contabilidad II"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none text-sm transition" />
            </div>

            <div>
              <label for="input-unidad" class="block text-sm font-semibold text-slate-700 mb-1.5">
                Unidad o Semana *
              </label>
              <input id="input-unidad" type="text" required
                placeholder="Ej: Semana 4 / Unidad 2"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none text-sm transition" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="input-titulo" class="block text-sm font-semibold text-slate-700 mb-1.5">
                Título del Gránulo Temático *
              </label>
              <input id="input-titulo" type="text" required
                placeholder="Ej: Tipicidad y Antijuridicidad / Mitosis y Meiosis / Derivadas Parciales"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none text-sm transition" />
            </div>

            <div>
              <label for="input-dinamica" class="block text-sm font-semibold text-slate-700 mb-1.5">
                Dinámica Pedagógica *
              </label>
              <select id="input-dinamica"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none text-sm font-medium text-slate-800 transition">
                <option value="Simulador de Toma de Decisiones (Caso aplicado en 4 etapas)">1. Simulador de Toma de Decisiones (Caso en 4 etapas)</option>
                <option value="Juego de Roles / Resolución de Crisis Profesional">2. Juego de Roles / Resolución de Crisis Profesional</option>
                <option value="Trivia Gamificada de Diagnóstico y Conceptos">3. Trivia Gamificada de Diagnóstico y Conceptos</option>
                <option value="Clasificador de Matrices / Análisis Crítico">4. Clasificador de Matrices / Análisis Crítico</option>
              </select>
            </div>
          </div>

          <div>
            <label for="input-objetivo" class="block text-sm font-semibold text-slate-700 mb-1.5">
              Resultado de Aprendizaje (Objetivo) *
            </label>
            <input id="input-objetivo" type="text" required
              placeholder="Ej: Diagnosticar fallas estructurales aplicando los criterios normativos estudiados en clase..."
              class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none text-sm transition" />
          </div>

          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="input-contenido" class="block text-sm font-semibold text-slate-700">
                Contenido Clave / Conceptos del Gránulo *
              </label>
              <span class="text-xs text-slate-400">Base conceptual estricta para la actividad</span>
            </div>
            <textarea id="input-contenido" rows="6" required
              placeholder="Pega aquí el resumen teórico, definiciones, fórmulas, protocolos, artículos legales o lecturas clave de la semana. El simulador se construirá 100% sobre este contenido..."
              class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none text-sm leading-relaxed transition"></textarea>
          </div>

          <div class="pt-2">
            <button id="btn-generar" type="submit"
              class="w-full bg-slate-900 hover:bg-indigo-700 text-white font-bold py-3.5 px-6 rounded-xl shadow-md transition-all flex items-center justify-center gap-2.5 text-sm sm:text-base cursor-pointer">
              <svg id="icon-sparkle" class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
              </svg>
              <svg id="icon-spinner" class="hidden w-5 h-5 animate-spin text-emerald-400" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
              </svg>
              <span id="btn-generar-texto">Generar Actividad Interactiva y Ficha Docente</span>
            </button>
          </div>
        </form>
      </div>

      <!-- Columna Lateral Informativa -->
      <aside class="lg:col-span-4 space-y-6">
        <div class="bg-slate-900 text-white rounded-2xl p-6 shadow-sm border border-slate-800">
          <h3 class="text-base font-bold text-emerald-400 uppercase tracking-wider mb-4 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
            </svg>
            Arquitectura Pedagógica
          </h3>
          <div class="space-y-4 text-sm text-slate-300">
            <div class="flex gap-3">
              <span class="w-6 h-6 rounded-full bg-indigo-600/30 border border-indigo-500/40 text-indigo-300 font-bold flex items-center justify-center shrink-0 text-xs">1</span>
              <p><strong class="text-white">Cero sesgo disciplinar:</strong> El motor adapta el vocabulario técnico, el rol profesional y los dilemas exclusivamente a la materia ingresada.</p>
            </div>
            <div class="flex gap-3">
              <span class="w-6 h-6 rounded-full bg-indigo-600/30 border border-indigo-500/40 text-indigo-300 font-bold flex items-center justify-center shrink-0 text-xs">2</span>
              <p><strong class="text-white">4 Etapas Secuenciales:</strong> Cada desafío evalúa criterios específicos del gránulo con retroalimentación formativa inmediata.</p>
            </div>
            <div class="flex gap-3">
              <span class="w-6 h-6 rounded-full bg-indigo-600/30 border border-indigo-500/40 text-indigo-300 font-bold flex items-center justify-center shrink-0 text-xs">3</span>
              <p><strong class="text-white">Exportación Autónoma:</strong> Descarga un archivo HTML jugable independiente para incrustar en Moodle, Canvas o GitHub Pages.</p>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
          <h4 class="font-bold text-slate-900 text-sm mb-2.5 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            Recomendación para el Gránulo
          </h4>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Para obtener escenarios de alta precisión técnica, incluye en el campo <strong>Contenido Clave</strong> los conceptos centrales, clasificaciones, criterios de decisión o errores frecuentes que los estudiantes suelen cometer en ese tema.
          </p>
        </div>
      </aside>
    </section>

    <!-- =================================================================== -->
    <!-- VISTA 2: SIMULADOR INTERACTIVO (VISTA DEL ESTUDIANTE)               -->
    <!-- =================================================================== -->
    <section id="vista-estudiante" class="hidden fade-in max-w-4xl mx-auto">
      <!-- Encabezado del Escenario -->
      <div class="bg-slate-900 text-white rounded-2xl p-6 sm:p-8 shadow-md mb-6 border-b-4 border-emerald-500">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
          <div class="flex flex-wrap items-center gap-2">
            <span id="est-badge-asignatura" class="bg-indigo-600 text-white text-xs font-bold px-3 py-1 rounded-full"></span>
            <span id="est-badge-dinamica" class="bg-slate-800 text-emerald-400 border border-slate-700 text-xs font-semibold px-3 py-1 rounded-full"></span>
          </div>
          <span id="est-rol" class="text-xs font-semibold text-slate-300 bg-slate-800/90 px-3 py-1.5 rounded-lg border border-slate-700"></span>
        </div>

        <h2 id="est-titulo" class="text-2xl sm:text-3xl font-extrabold text-white mb-4"></h2>

        <div class="bg-slate-800/80 border border-slate-700/80 rounded-xl p-4 sm:p-5">
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-400 block mb-1">
            Contexto Profesional del Caso
          </span>
          <p id="est-contexto" class="text-sm sm:text-base text-slate-200 leading-relaxed"></p>
        </div>
      </div>

      <!-- Contenedor Dinámico del Juego (Etapa activa o Resultados finales) -->
      <div id="zona-juego-activa" class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 sm:p-8">
        <!-- Barra de progreso -->
        <div class="flex items-center justify-between text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">
          <span id="juego-progreso-texto">Etapa 1 de 4</span>
          <span id="juego-puntaje-texto" class="text-indigo-700">Puntaje: 0 pts</span>
        </div>
        <div class="w-full bg-slate-100 h-2.5 rounded-full overflow-hidden mb-8">
          <div id="juego-barra-progreso" class="bg-emerald-500 h-full transition-all duration-500" style="width: 25%"></div>
        </div>

        <!-- Pregunta y Opciones -->
        <div class="mb-6">
          <span id="etapa-subtitulo" class="inline-block text-xs font-bold text-indigo-700 bg-indigo-50 px-2.5 py-1 rounded-md mb-2"></span>
          <h3 id="etapa-pregunta" class="text-lg sm:text-xl font-bold text-slate-900 leading-snug"></h3>
        </div>

        <div id="etapa-opciones" class="space-y-3.5 mb-6"></div>

        <!-- Panel de Retroalimentación Inmediata -->
        <div id="etapa-feedback" class="hidden p-5 rounded-xl border mb-6 transition-all">
          <div class="flex items-center justify-between mb-1.5">
            <span id="feedback-nivel" class="font-bold text-sm"></span>
            <span id="feedback-puntos" class="text-xs font-extrabold px-2.5 py-0.5 rounded-full bg-white/90 shadow-2xs"></span>
          </div>
          <p id="feedback-texto" class="text-sm leading-relaxed"></p>
        </div>

        <div class="flex justify-end">
          <button id="btn-siguiente-etapa" onclick="avanzarEtapa()" disabled
            class="bg-slate-900 hover:bg-indigo-700 disabled:bg-slate-300 text-white font-bold py-3 px-6 rounded-xl transition flex items-center gap-2 text-sm cursor-pointer disabled:cursor-not-allowed">
            <span id="btn-siguiente-texto">Confirmar y Continuar</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Pantalla Final de Resultados -->
      <div id="zona-juego-resultados" class="hidden bg-white rounded-2xl shadow-sm border border-slate-200 p-6 sm:p-8 fade-in">
        <div class="text-center pb-8 mb-8 border-b border-slate-100">
          <div id="res-icono-box" class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-9 h-9" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
            </svg>
          </div>
          <span id="res-nivel-badge" class="inline-block text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full mb-2"></span>
          <h3 id="res-puntaje-final" class="text-3xl font-extrabold text-slate-900"></h3>
          <p id="res-mensaje-final" class="text-slate-600 max-w-2xl mx-auto text-sm sm:text-base leading-relaxed mt-3"></p>
        </div>

        <h4 class="font-bold text-slate-900 text-base sm:text-lg mb-4">Bitácora de Decisiones y Retroalimentación</h4>
        <div id="res-bitacora" class="space-y-4 mb-8"></div>

        <div class="flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-slate-100">
          <button onclick="reiniciarSimulador()"
            class="bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold py-3 px-5 rounded-xl transition text-sm cursor-pointer">
            Reiniciar Simulador
          </button>

          <div class="flex flex-wrap gap-3">
            <button onclick="exportarEvidenciaEstudiante()"
              class="bg-indigo-50 hover:bg-indigo-100 text-indigo-700 border border-indigo-200 font-bold py-3 px-5 rounded-xl transition text-sm cursor-pointer">
              Descargar Evidencia (.txt)
            </button>
            <button onclick="cambiarVista('ficha')"
              class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 px-5 rounded-xl transition text-sm cursor-pointer">
              Ir a Ficha Docente
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- =================================================================== -->
    <!-- VISTA 3: FICHA PEDAGÓGICA Y EXPORTACIÓN (VISTA DEL DOCENTE)         -->
    <!-- =================================================================== -->
    <section id="vista-ficha" class="hidden fade-in max-w-5xl mx-auto">
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <!-- Cabecera de Ficha con Botones de Acción -->
        <div class="bg-slate-900 text-white p-6 sm:p-8 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-emerald-400">
              Guía Instruccional Lista para LMS
            </span>
            <h2 id="ficha-titulo-reto" class="text-2xl font-bold mt-1"></h2>
            <p id="ficha-meta" class="text-sm text-slate-400 mt-1"></p>
          </div>

          <div class="flex flex-wrap items-center gap-3">
            <button onclick="copiarFichaPortapapeles()"
              class="bg-slate-800 hover:bg-slate-700 border border-slate-700 text-white font-semibold py-2.5 px-4 rounded-xl text-xs sm:text-sm transition cursor-pointer">
              Copiar Ficha al Portapapeles
            </button>

            <button onclick="descargarHtmlStandalone()"
              class="bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-extrabold py-2.5 px-4 rounded-xl text-xs sm:text-sm shadow-sm transition cursor-pointer flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
