  <!-- LÓGICA DE LA APLICACIÓN -->
  <script>
    // Muestras multidisciplinarias opcionales (no se cargan por defecto; el formulario inicia 100% vacío)
    const MUESTRAS_DISCIPLINARES = {
      salud: {
        asignatura: "Enfermería en Urgencias y Cuidados Críticos",
        unidad: "Semana 5 - Unidad 2",
        titulo: "Protocolo de Triaje y Manejo Inicial de Sepsis",
        dinamica: "Juego de Roles / Resolución de Crisis Profesional",
        objetivo: "Priorizar intervenciones clínicas basadas en signos de alarma hemodinámica y aplicar el paquete de medidas de la primera hora (Hour-1 Bundle).",
        contenido: "La sepsis es una disfunción orgánica potencialmente mortal causada por una respuesta desregulada del huésped a la infección. Criterios qSOFA: frecuencia respiratoria >= 22 rpm, alteración del estado mental (Glasgow < 15) y presión arterial sistólica <= 100 mmHg. El paquete de la primera hora exige: 1) Medir nivel de lactato sérico; 2) Obtener hemocultivos antes de administrar antibióticos; 3) Administrar antibióticos de amplio espectro por vía intravenosa; 4) Iniciar reanimación rápida con cristaloides (30 ml/kg) si hay hipotensión o lactato >= 4 mmol/L; 5) Aplicar vasopresores si persiste hipotensión durante o después de la reanimación hídrica para mantener PAM >= 65 mmHg."
      },
      derecho: {
        asignatura: "Derecho Penal General",
        unidad: "Unidad 3 - Semana 7",
        titulo: "Teoría del Delito: Tipicidad, Antijuridicidad y Causales de Justificación",
        dinamica: "Simulador de Toma de Decisiones (Caso aplicado en 4 etapas)",
        objetivo: "Determinar la existencia de responsabilidad penal evaluando los elementos objetivos y subjetivos del tipo penal y la procedencia de la legítima defensa.",
        contenido: "Para que una conducta sea punible se requiere que sea típica, antijurídica y culpable. La tipicidad exige adecuación exacta al supuesto de hecho legal (elementos objetivos, sujeto activo/pasivo, verbo rector) y elemento subjetivo (dolo, culpa o preterintención). La antijuridicidad implica lesión o puesta en peligro efectiva del bien jurídico sin justa causa. Causales de ausencia de responsabilidad (Art. 32 CP): legítima defensa (agresión actual o inminente, injusta, necesidad de defensa y proporcionalidad del medio empleado), estado de necesidad justificante y estricto cumplimiento de un deber legal. Si falta proporcionalidad, se configura exceso en la legítima defensa con atenuación punitiva."
      },
      ingenieria: {
        asignatura: "Arquitectura de Software y Sistemas Distribuidos",
        unidad: "Semana 6 - Módulo 3",
        titulo: "Teorema CAP, Consistencia Eventual y Tolerancia a Particiones",
        dinamica: "Clasificador de Matrices / Análisis Crítico",
        objetivo: "Seleccionar estrategias de replicación y almacenamiento distribuido equilibrando disponibilidad y consistencia según los requisitos críticos del negocio.",
        contenido: "El Teorema CAP establece que en un sistema distribuido de datos es imposible garantizar simultáneamente más de dos de las siguientes tres propiedades: Consistencia (Consistency: todos los nodos ven los mismos datos al mismo tiempo), Disponibilidad (Availability: cada solicitud recibe una respuesta sin garantía de que contenga la versión más reciente) y Tolerancia a Particiones (Partition Tolerance: el sistema sigue operando pese a pérdida o retraso de mensajes entre nodos). Ante una partición de red (P), el arquitecto debe elegir entre CP (prioriza consistencia rechazando escrituras/lecturas inseguras, ideal para transacciones bancarias) o AP (prioriza disponibilidad permitiendo lecturas eventualmente consistentes, ideal para carritos de compra o catálogos)."
      }
    };

    // Estado global de la aplicación
    let estado = {
      metadatos: null,
      actividad: null,
      etapaActual: 0,
      opcionSeleccionada: null,
      historial: []
    };

    // Utilidad para mostrar notificaciones no intrusivas (reemplaza alert)
    function mostrarNotificacion(mensaje, tipo = 'info') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      const colores = tipo === 'exito'
        ? 'bg-emerald-900 text-emerald-50 border-emerald-700'
        : tipo === 'error'
        ? 'bg-rose-900 text-rose-50 border-rose-700'
        : 'bg-slate-900 text-white border-slate-700';

      toast.className = `pointer-events-auto px-4 py-3 rounded-xl border shadow-lg text-xs sm:text-sm font-medium fade-in ${colores}`;
      toast.textContent = mensaje;
      container.appendChild(toast);

      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transition = 'opacity 0.3s ease';
        setTimeout(() => toast.remove(), 300);
      }, 3000);
    }

    // Cambiar entre las 3 vistas principales
    function cambiarVista(vista) {
      if ((vista === 'estudiante' || vista === 'ficha') && !estado.actividad) {
        mostrarNotificacion("Primero genera una actividad desde la pestaña Gránulo Temático.", "error");
        return;
      }

      ['docente', 'estudiante', 'ficha'].forEach(v => {
        const sec = document.getElementById(`vista-${v}`);
        const btn = document.getElementById(`tab-btn-${v}`);
        if (v === vista) {
          sec.classList.remove('hidden');
          btn.classList.add('bg-indigo-600', 'text-white', 'shadow-sm');
          btn.classList.remove('text-slate-300', 'text-slate-400');
        } else {
          sec.classList.add('hidden');
          btn.classList.remove('bg-indigo-600', 'text-white', 'shadow-sm');
          btn.classList.add(estado.actividad ? 'text-slate-300' : 'text-slate-400');
        }
      });
    }

    // Habilitar pestañas de estudiante y ficha tras generar actividad
    function habilitarPestanasSecundarias() {
      ['estudiante', 'ficha'].forEach(v => {
        const btn = document.getElementById(`tab-btn-${v}`);
        btn.disabled = false;
        btn.classList.remove('opacity-50', 'cursor-not-allowed', 'text-slate-400');
        btn.classList.add('text-slate-300', 'hover:text-white', 'cursor-pointer');
      });
    }

    // Cargar muestra opcional de otra facultad
    function cargarMuestra(clave) {
      const m = MUESTRAS_DISCIPLINARES[clave];
      if (!m) return;
      document.getElementById('input-asignatura').value = m.asignatura;
      document.getElementById('input-unidad').value = m.unidad;
      document.getElementById('input-titulo').value = m.titulo;
      document.getElementById('input-dinamica').value = m.dinamica;
      document.getElementById('input-objetivo').value = m.objetivo;
      document.getElementById('input-contenido').value = m.contenido;
      document.getElementById('error-box').classList.add('hidden');
      mostrarNotificacion(`Muestra de ${m.asignatura} cargada en el formulario.`);
    }

    // Limpiar todos los campos
    function limpiarFormulario() {
      document.getElementById('form-granulo').reset();
      document.getElementById('error-box').classList.add('hidden');
      mostrarNotificacion("Campos del formulario limpios.");
    }

    // Llamada a Gemini API para construir el simulador y la ficha pedagógica
    async function generarActividad(event) {
      event.preventDefault();

      const asignatura = document.getElementById('input-asignatura').value.trim();
      const unidad = document.getElementById('input-unidad').value.trim();
      const titulo = document.getElementById('input-titulo').value.trim();
      const dinamica = document.getElementById('input-dinamica').value;
      const objetivo = document.getElementById('input-objetivo').value.trim();
      const contenido = document.getElementById('input-contenido').value.trim();

      const errorBox = document.getElementById('error-box');
      const errorText = document.getElementById('error-text');

      if (!asignatura || !titulo || !contenido) {
        errorText.textContent = "Por favor completa la asignatura, el título del gránulo y el contenido clave.";
        errorBox.classList.remove('hidden');
        return;
      }

      errorBox.classList.add('hidden');
      setEstadoCarga(true);

      const apiKey = ""; // Inyectada automáticamente en tiempo de ejecución
      const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

      const systemInstruction = `Eres un experto diseñador instruccional universitario especializado en aprendizaje activo y gamificación educativa para TODAS las disciplinas académicas (Ciencias de la Salud, Derecho, Ingenierías, Ciencias Exactas, Humanidades, Artes, Ciencias Económicas, etc.).
Tu tarea es transformar el gránulo temático ingresado por el docente en una actividad interactiva rigurosa, técnica y 100% fiel a los conceptos proporcionados.
REGLAS ESTRICTAS:
1. Adapta todo el lenguaje, el rol del estudiante, el escenario y los criterios de evaluación EXCLUSIVAMENTE a la asignatura y al contenido proporcionado por el docente. Nunca introduzcas temas ajenos a la materia ingresada.
2. Genera exactamente 4 etapas o desafíos progresivos.
3. Cada etapa debe tener exactamente 3 opciones de respuesta/decisión plausibles, donde una es técnicamente óptima (25 puntos), una es parcialmente adecuada o con reservas (15 puntos) y una es incorrecta o riesgosa (5 puntos).
4. Cada opción debe incluir retroalimentación pedagógica fundamentada en los conceptos exactos del gránulo.`;

      const userPrompt = `Construye una actividad interactiva bajo la dinámica "${dinamica}" utilizando estrictamente esta información del docente:
- Asignatura: ${asignatura}
- Unidad / Semana: ${unidad}
- Título del Gránulo Temático: ${titulo}
- Resultado de Aprendizaje: ${objetivo}
- Contenido Clave / Conceptos del Gránulo:
${contenido}`;

      const payload = {
        contents: [{ parts: [{ text: userPrompt }] }],
        systemInstruction: { parts: [{ text: systemInstruction }] },
        generationConfig: {
          responseMimeType: "application/json",
          responseSchema: {
            type: "OBJECT",
            properties: {
              tituloReto: { type: "STRING" },
              rolEstudiante: { type: "STRING", description: "Rol profesional o disciplinar específico de la materia (ej. Médico Residente, Juez de Control, Arquitecto de Software)" },
              contextoCaso: { type: "STRING", description: "Escenario realista y técnico contextualizado en la disciplina del docente" },
              fichaDocente: {
                type: "OBJECT",
                properties: {
                  situacion: { type: "STRING" },
                  mision: { type: "STRING" },
                  instrucciones: { type: "ARRAY", items: { type: "STRING" } },
                  productoEsperado: { type: "STRING" },
                  justificacionRubrica: { type: "STRING" }
                },
                required: ["situacion", "mision", "instrucciones", "productoEsperado", "justificacionRubrica"]
              },
              etapas: {
                type: "ARRAY",
                items: {
                  type: "OBJECT",
                  properties: {
                    numero: { type: "INTEGER" },
                    tituloEtapa: { type: "STRING" },
                    escenarioPregunta: { type: "STRING" },
                    opciones: {
                      type: "ARRAY",
                      items: {
                        type: "OBJECT",
                        properties: {
                          id: { type: "STRING" },
                          texto: { type: "STRING" },
                          puntaje: { type: "INTEGER" },
                          nivelImpacto: { type: "STRING", description: "Ej: Decisión Óptima, Decisión Parcial, Decisión Riesgosa / Incorrecta" },
                          retroalimentacion: { type: "STRING" }
                        },
                        required: ["id", "texto", "puntaje", "nivelImpacto", "retroalimentacion"]
                      }
                    }
                  },
                  required: ["numero", "tituloEtapa", "escenarioPregunta", "opciones"]
                }
              }
            },
            required: ["tituloReto", "rolEstudiante", "contextoCaso", "fichaDocente", "etapas"]
          }
        }
      };

      const maxIntentos = 4;
      let retraso = 1000;

      for (let intento = 0; intento < maxIntentos; intento++) {
        try {
          const response = await fetch(apiUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });

          if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
          }

          const data = await response.json();
          const textoJson = data?.candidates?.[0]?.content?.parts?.[0]?.text;

          if (!textoJson) {
            throw new Error("Respuesta vacía del servicio.");
          }

          const actividadParsed = JSON.parse(textoJson);

          estado.metadatos = { asignatura, unidad, titulo, dinamica, objetivo };
          estado.actividad = actividadParsed;

          renderizarFichaDocente();
          reiniciarSimulador();
          habilitarPestanasSecundarias();
          setEstadoCarga(false);
          cambiarVista('estudiante');
          mostrarNotificacion("¡Simulador y ficha pedagógica generados con éxito!", "exito");
          return;

        } catch (err) {
          if (intento === maxIntentos - 1) {
            setEstadoCarga(false);
            errorText.textContent = "Ocurrió un inconveniente al conectar con el motor de generación. Por favor intenta nuevamente en unos segundos.";
            errorBox.classList.remove('hidden');
          } else {
            await new Promise(resolve => setTimeout(resolve, retraso));
            retraso *= 2;
          }
        }
      }
    }

    function setEstadoCarga(cargando) {
      const btn = document.getElementById('btn-generar');
      const iconSparkle = document.getElementById('icon-sparkle');
      const iconSpinner = document.getElementById('icon-spinner');
      const texto = document.getElementById('btn-generar-texto');

      btn.disabled = cargando;
      if (cargando) {
        iconSparkle.classList.add('hidden');
        iconSpinner.classList.remove('hidden');
        texto.textContent = "Construyendo simulador disciplinar y ficha...";
      } else {
        iconSparkle.classList.remove('hidden');
        iconSpinner.classList.add('hidden');
        texto.textContent = "Generar Actividad Interactiva y Ficha Docente";
      }
    }

    // =========================================================================
    // MOTOR DEL SIMULADOR INTERACTIVO (VISTA DEL ESTUDIANTE)
    // =========================================================================
    function reiniciarSimulador() {
      if (!estado.actividad || !estado.metadatos) return;

      estado.etapaActual = 0;
      estado.opcionSeleccionada = null;
      estado.historial = [];

      document.getElementById('est-badge-asignatura').textContent = `${estado.metadatos.asignatura} • ${estado.metadatos.unidad}`;
      document.getElementById('est-badge-dinamica').textContent = estado.metadatos.dinamica;
      document.getElementById('est-rol').textContent = `Rol: ${estado.actividad.rolEstudiante}`;
      document.getElementById('est-titulo').textContent = estado.actividad.tituloReto;
      document.getElementById('est-contexto').textContent = estado.actividad.contextoCaso;

      document.getElementById('zona-juego-activa').classList.remove('hidden');
      document.getElementById('zona-juego-resultados').classList.add('hidden');

      renderizarEtapaActual();
    }

    function renderizarEtapaActual() {
      const etapas = estado.actividad.etapas;
      const idx = estado.etapaActual;
      const etapa = etapas[idx];
      const puntajeAcumulado = estado.historial.reduce((sum, item) => sum + item.puntaje, 0);

      document.getElementById('juego-progreso-texto').textContent = `Etapa ${idx + 1} de ${etapas.length}`;
      document.getElementById('juego-puntaje-texto').textContent = `Puntaje acumulado: ${puntajeAcumulado} pts`;
      document.getElementById('juego-barra-progreso').style.width = `${((idx + 1) / etapas.length) * 100}%`;

      document.getElementById('etapa-subtitulo').textContent = etapa.tituloEtapa;
      document.getElementById('etapa-pregunta').textContent = etapa.escenarioPregunta;

      const contOpciones = document.getElementById('etapa-opciones');
      contOpciones.innerHTML = '';

      etapa.opciones.forEach((op, i) => {
        const letra = String.fromCharCode(65 + i);
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'opcion-btn w-full text-left p-4 sm:p-5 rounded-xl border-2 border-slate-200 hover:border-indigo-400 hover:bg-slate-50 transition-all flex items-start gap-4 cursor-pointer';
        btn.innerHTML = `
          <span class="opcion-letra w-7 h-7 rounded-full bg-slate-100 text-slate-700 font-bold text-sm flex items-center justify-center shrink-0 mt-0.5 transition">
            ${letra}
          </span>
          <span class="font-medium text-slate-800 text-sm sm:text-base leading-relaxed">${op.texto}</span>
        `;
        btn.onclick = () => seleccionarOpcion(op, btn);
        contOpciones.appendChild(btn);
      });

      document.getElementById('etapa-feedback').classList.add('hidden');
      const btnNext = document.getElementById('btn-siguiente-etapa');
      btnNext.disabled = true;
      document.getElementById('btn-siguiente-texto').textContent =
        idx + 1 < etapas.length ? 'Confirmar y Avanzar a Siguiente Etapa' : 'Finalizar Simulación y Ver Diagnóstico';
    }

    function seleccionarOpcion(opcion, botonSeleccionado) {
      estado.opcionSeleccionada = opcion;

      // Actualizar estilos visuales de los botones
      document.querySelectorAll('.opcion-btn').forEach(btn => {
        btn.classList.remove('border-indigo-600', 'bg-indigo-50/60', 'shadow-xs');
        btn.classList.add('border-slate-200');
        const badge = btn.querySelector('.opcion-letra');
        badge.classList.remove('bg-indigo-600', 'text-white');
        badge.classList.add('bg-slate-100', 'text-slate-700');
      });

      botonSeleccionado.classList.remove('border-slate-200');
      botonSeleccionado.classList.add('border-indigo-600', 'bg-indigo-50/60', 'shadow-xs');
      const badgeSel = botonSeleccionado.querySelector('.opcion-letra');
      badgeSel.classList.remove('bg-slate-100', 'text-slate-700');
      badgeSel.classList.add('bg-indigo-600', 'text-white');

      // Mostrar retroalimentación inmediata
      const fbBox = document.getElementById('etapa-feedback');
      const fbNivel = document.getElementById('feedback-nivel');
      const fbPuntos = document.getElementById('feedback-puntos');
      const fbTexto = document.getElementById('feedback-texto');

      fbBox.className = 'p-5 rounded-xl border mb-6 fade-in ';
      if (opcion.puntaje >= 25) {
        fbBox.className += 'bg-emerald-50 border-emerald-200 text-emerald-950';
      } else if (opcion.puntaje >= 15) {
        fbBox.className += 'bg-amber-50 border-amber-200 text-amber-950';
      } else {
        fbBox.className += 'bg-rose-50 border-rose-200 text-rose-950';
      }

      fbNivel.textContent = `Evaluación: ${opcion.nivelImpacto}`;
      fbPuntos.textContent = `+${opcion.puntaje} pts`;
      fbTexto.textContent = opcion.retroalimentacion;
      fbBox.classList.remove('hidden');

      document.getElementById('btn-siguiente-etapa').disabled = false;
    }

    function avanzarEtapa() {
      if (!estado.opcionSeleccionada) return;

      const etapa = estado.actividad.etapas[estado.etapaActual];
      estado.historial.push({
        etapa: etapa.tituloEtapa,
        decision: estado.opcionSeleccionada.texto,
        puntaje: estado.opcionSeleccionada.puntaje,
        nivelImpacto: estado.opcionSeleccionada.nivelImpacto,
        retroalimentacion: estado.opcionSeleccionada.retroalimentacion
      });

      estado.opcionSeleccionada = null;

      if (estado.etapaActual + 1 < estado.actividad.etapas.length) {
        estado.etapaActual++;
        renderizarEtapaActual();
      } else {
        mostrarResultadosFinales();
      }
    }

    function mostrarResultadosFinales() {
      document.getElementById('zona-juego-activa').classList.add('hidden');
      document.getElementById('zona-juego-resultados').classList.remove('hidden');

      const total = estado.historial.reduce((acc, item) => acc + item.puntaje, 0);
      const max = estado.actividad.etapas.length * 25;
      const pct = (total / max) * 100;

      const iconBox = document.getElementById('res-icono-box');
      const badge = document.getElementById('res-nivel-badge');
      const mensaje = document.getElementById('res-mensaje-final');

      if (pct >= 85) {
        iconBox.className = 'w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-4 bg-emerald-100 text-emerald-700';
        badge.className = 'inline-block text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full mb-2 bg-emerald-600 text-white';
        badge.textContent = 'Desempeño Sobresaliente';
        mensaje.textContent = 'Has aplicado con rigor técnico los conceptos del gránulo temático, tomando decisiones fundamentadas y resolviendo eficazmente cada etapa del desafío.';
      } else if (pct >= 60) {
        iconBox.className = 'w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-4 bg-amber-100 text-amber-700';
        badge.className = 'inline-block text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full mb-2 bg-amber-500 text-white';
        badge.textContent = 'Desempeño Satisfactorio / En Desarrollo';
        mensaje.textContent = 'Comprendes los principios generales del tema, aunque algunas decisiones presentaron vacíos conceptuales o riesgos que conviene revisar.';
      } else {
        iconBox.className = 'w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-4 bg-rose-100 text-rose-700';
        badge.className = 'inline-block text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full mb-2 bg-rose-600 text-white';
        badge.textContent = 'Requiere Refuerzo Conceptual';
        mensaje.textContent = 'Las decisiones tomadas evidencian dificultades en la aplicación de los conceptos clave de la semana. Revisa la bitácora inferior e inténtalo de nuevo.';
      }

      document.getElementById('res-puntaje-final').textContent = `Calificación Obtenida: ${total} / ${max} pts`;

      const bitacora = document.getElementById('res-bitacora');
      bitacora.innerHTML = '';

      estado.historial.forEach((item, idx) => {
        const badgeColor = item.puntaje >= 25
          ? 'bg-emerald-100 text-emerald-800'
          : item.puntaje >= 15
          ? 'bg-amber-100 text-amber-800'
          : 'bg-rose-100 text-rose-800';

        const card = document.createElement('div');
        card.className = 'p-4 rounded-xl bg-slate-50 border border-slate-200';
        card.innerHTML = `
          <div class="flex flex-wrap items-center justify-between gap-2 mb-1.5">
            <span class="text-xs font-bold text-slate-500 uppercase">Etapa ${idx + 1}: ${item.etapa}</span>
            <span class="text-xs font-bold px-2.5 py-0.5 rounded-md ${badgeColor}">${item.nivelImpacto} (+${item.puntaje} pts)</span>
          </div>
          <p class="font-semibold text-slate-900 text-sm mb-1">Selección: "${item.decision}"</p>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">${item.retroalimentacion}</p>
        `;
        bitacora.appendChild(card);
      });
    }

    function exportarEvidenciaEstudiante() {
      if (!estado.actividad || estado.historial.length === 0) return;
      const total = estado.historial.reduce((acc, item) => acc + item.puntaje, 0);
      const max = estado.actividad.etapas.length * 25;

      const contenido = [
        `EVIDENCIA DE SIMULACIÓN ACADÉMICA`,
        `====================================================================`,
        `Asignatura: ${estado.metadatos.asignatura} (${estado.metadatos.unidad})`,
        `Gránulo Temático: ${estado.metadatos.titulo}`,
        `Actividad: ${estado.actividad.tituloReto}`,
        `Rol Asumido: ${estado.actividad.rolEstudiante}`,
        `Puntaje Total: ${total} / ${max} puntos`,
        `Fecha de realización: ${new Date().toLocaleString()}`,
        `====================================================================\n`,
        ...estado.historial.map((h, i) =>
          `ETAPA ${i + 1}: ${h.etapa}\n- Decisión: ${h.decision}\n- Valoración: ${h.nivelImpacto} (+${h.puntaje} pts)\n- Retroalimentación: ${h.retroalimentacion}\n`
        )
      ].join('\n');

      descargarArchivo(contenido, `Evidencia_${estado.metadatos.titulo.replace(/[^a-zA-Z0-9]/g, '_')}.txt`, 'text/plain;charset=utf-8');
      mostrarNotificacion("Evidencia del estudiante descargada.", "exito");
    }

    // =========================================================================
    // VISTA 3: FICHA DOCENTE Y EXPORTACIÓN DE JUEGO HTML INDEPENDIENTE
    // =========================================================================
    function renderizarFichaDocente() {
      const f = estado.actividad.fichaDocente;
      const m = estado.metadatos;

      document.getElementById('ficha-titulo-reto').textContent = estado.actividad.tituloReto;
      document.getElementById('ficha-meta').textContent = `${m.asignatura} • ${m.unidad} • Gránulo: ${m.titulo}`;
      document.getElementById('ficha-situacion').textContent = f.situacion;
      document.getElementById('ficha-mision').textContent = f.mision;

      const ol = document.getElementById('ficha-instrucciones');
      ol.innerHTML = '';
      f.instrucciones.forEach(inst => {
        const li = document.createElement('li');
        li.textContent = inst;
        ol.appendChild(li);
      });

      document.getElementById('ficha-producto').textContent = f.productoEsperado;
      document.getElementById('ficha-justificacion').textContent = f.justificacionRubrica;
    }

    function construirTextoFicha() {
      const f = estado.actividad.fichaDocente;
      const m = estado.metadatos;
      return `====================================================================
GUÍA DE RETO INTERACTIVO - ${m.asignatura.toUpperCase()}
====================================================================
UNIDAD / SEMANA: ${m.unidad}
GRÁNULO TEMÁTICO: ${m.titulo}
DINÁMICA PEDAGÓGICA: ${m.dinamica}
TÍTULO DEL RETO: ${estado.actividad.tituloReto}
ROL DEL ESTUDIANTE: ${estado.actividad.rolEstudiante}

1. SITUACIÓN / CONTEXTO:
${f.situacion}

2. MISIÓN / DESAFÍO:
${f.mision}

3. INSTRUCCIONES DE DESARROLLO:
${f.instrucciones.map((inst, i) => `${i + 1}. ${inst}`).join('\n')}

4. PRODUCTO ESPERADO:
${f.productoEsperado}

5. JUSTIFICACIÓN Y CRITERIOS DE RÚBRICA:
${f.justificacionRubrica}
====================================================================`;
    }

    function copiarFichaPortapapeles() {
      const texto = construirTextoFicha();
      const area = document.createElement('textarea');
      area.value = texto;
      document.body.appendChild(area);
      area.select();
      document.execCommand('copy');
      document.body.removeChild(area);
      mostrarNotificacion("Ficha pedagógica copiada al portapapeles.", "exito");
    }

    // Genera un archivo HTML 100% autónomo con el juego embebido para subir a Moodle/Canvas/GitHub
    function descargarHtmlStandalone() {
      if (!estado.actividad || !estado.metadatos) return;

      const datosEmbebidos = JSON.stringify({
        metadatos: estado.metadatos,
        actividad: estado.actividad
      });

      const htmlAutonomo = `<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>${estado.actividad.tituloReto} - ${estado.metadatos.asignatura}</title>
  <script src="https://cdn.tailwindcss.com"><\/script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen py-8 px-4">
  <div class="max-w-4xl mx-auto">
    <div class="bg-slate-900 text-white rounded-2xl p-6 sm:p-8 shadow-md mb-6 border-b-4 border-emerald-500">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
        <span class="bg-indigo-600 text-white text-xs font-bold px-3 py-1 rounded-full">${estado.metadatos.asignatura} • ${estado.metadatos.unidad}</span>
        <span class="text-xs font-semibold text-emerald-400 bg-slate-800 px-3 py-1 rounded-lg border border-slate-700">Rol: ${estado.actividad.rolEstudiante}</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold mb-4">${estado.actividad.tituloReto}</h1>
      <div class="bg-slate-800/80 border border-slate-700 rounded-xl p-4 text-sm sm:text-base text-slate-200 leading-relaxed">
        <strong class="text-emerald-400 block text-xs uppercase tracking-wider mb-1">Contexto del Caso</strong>
        ${estado.actividad.contextoCaso}
      </div>
    </div>

    <div id="app-juego" class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 sm:p-8"></div>
  </div>

  <script>
    const DATA = ${datosEmbebidos};
    let paso = 0;
    let seleccion = null;
    let historial = [];

    function render() {
      const cont = document.getElementById('app-juego');
      const etapas = DATA.actividad.etapas;

      if (paso >= etapas.length) {
        const total = historial.reduce((a, b) => a + b.puntaje, 0);
        const max = etapas.length * 25;
        const pct = (total / max) * 100;
        const nivel = pct >= 85 ? 'Desempeño Sobresaliente' : pct >= 60 ? 'Desempeño Satisfactorio' : 'Requiere Refuerzo Conceptual';
        const color = pct >= 85 ? 'bg-emerald-600' : pct >= 60 ? 'bg-amber-500' : 'bg-rose-600';

        cont.innerHTML = \`
          <div class="text-center pb-6 mb-6 border-b border-slate-100">
            <span class="inline-block text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full text-white \${color} mb-2">\${nivel}</span>
            <h2 class="text-3xl font-extrabold text-slate-900">Puntaje Final: \${total} / \${max} pts</h2>
          </div>
          <h3 class="font-bold text-slate-900 mb-4">Bitácora de Decisiones</h3>
          <div class="space-y-3 mb-6">
            \${historial.map((h, i) => \`
              <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
                <div class="flex justify-between text-xs font-bold text-slate-500 mb-1">
                  <span>ETAPA \${i + 1}: \${h.etapa}</span>
                  <span>\${h.nivelImpacto} (+\${h.puntaje} pts)</span>
                </div>
                <p class="font-semibold text-sm text-slate-900 mb-1">"\${h.decision}"</p>
                <p class="text-xs sm:text-sm text-slate-600">\${h.retroalimentacion}</p>
              </div>
            \`).join('')}
          </div>
          <button onclick="reiniciar()" class="bg-slate-900 hover:bg-indigo-700 text-white font-bold py-3 px-6 rounded-xl text-sm cursor-pointer">
            Volver a Intentar
          </button>
        \`;
        return;
      }

      const etapa = etapas[paso];
      const pts = historial.reduce((a, b) => a + b.puntaje, 0);

      cont.innerHTML = \`
        <div class="flex justify-between text-xs font-bold text-slate-500 uppercase mb-2">
          <span>Etapa \${paso + 1} de \${etapas.length}</span>
          <span class="text-indigo-700">Puntaje: \${pts} pts</span>
        </div>
        <div class="w-full bg-slate-100 h-2.5 rounded-full overflow-hidden mb-6">
          <div class="bg-emerald-500 h-full" style="width: \${((paso + 1) / etapas.length) * 100}%"></div>
        </div>
        <span class="inline-block text-xs font-bold text-indigo-700 bg-indigo-50 px-2.5 py-1 rounded-md mb-2">\${etapa.tituloEtapa}</span>
        <h2 class="text-lg sm:text-xl font-bold text-slate-900 mb-5">\${etapa.escenarioPregunta}</h2>
        <div class="space-y-3 mb-6">
          \${etapa.opciones.map((op, i) => \`
            <button onclick="elegir(\${i})" class="w-full text-left p-4 rounded-xl border-2 transition flex items-start gap-3 cursor-pointer \${seleccion === i ? 'border-indigo-600 bg-indigo-50/60' : 'border-slate-200 hover:border-slate-300'}">
              <span class="w-7 h-7 rounded-full font-bold text-sm flex items-center justify-center shrink-0 \${seleccion === i ? 'bg-indigo-600 text-white' : 'bg-slate-100 text-slate-700'}">\${String.fromCharCode(65 + i)}</span>
              <span class="text-sm sm:text-base font-medium text-slate-800">\${op.texto}</span>
            </button>
          \`).join('')}
        </div>
        \${seleccion !== null ? \`
          <div class="p-4 rounded-xl border mb-6 \${etapa.opciones[seleccion].puntaje >= 25 ? 'bg-emerald-50 border-emerald-200 text-emerald-950' : etapa.opciones[seleccion].puntaje >= 15 ? 'bg-amber-50 border-amber-200 text-amber-950' : 'bg-rose-50 border-rose-200 text-rose-950'}">
            <div class="flex justify-between font-bold text-sm mb-1">
              <span>\${etapa.opciones[seleccion].nivelImpacto}</span>
              <span>+\${etapa.opciones[seleccion].puntaje} pts</span>
            </div>
            <p class="text-sm">\${etapa.opciones[seleccion].retroalimentacion}</p>
          </div>
        \` : ''}
        <div class="flex justify-end">
          <button onclick="siguiente()" \${seleccion === null ? 'disabled' : ''} class="bg-slate-900 hover:bg-indigo-700 disabled:bg-slate-300 text-white font-bold py-3 px-6 rounded-xl text-sm cursor-pointer disabled:cursor-not-allowed">
            \${paso + 1 < etapas.length ? 'Confirmar y Continuar' : 'Ver Resultados Finales'}
          </button>
        </div>
      \`;
    }

    function elegir(i) { seleccion = i; render(); }
    function siguiente() {
      if (seleccion === null) return;
      const etapa = DATA.actividad.etapas[paso];
      const op = etapa.opciones[seleccion];
      historial.push({ etapa: etapa.tituloEtapa, decision: op.texto, puntaje: op.puntaje, nivelImpacto: op.nivelImpacto, retroalimentacion: op.retroalimentacion });
      seleccion = null;
      paso++;
      render();
    }
    function reiniciar() { paso = 0; seleccion = null; historial = []; render(); }
    render();
  <\/script>
</body>
</html>`;

      const nombreArchivo = `Simulador_${estado.metadatos.titulo.replace(/[^a-zA-Z0-9]/g, '_')}.html`;
      descargarArchivo(htmlAutonomo, nombreArchivo, 'text/html;charset=utf-8');
      mostrarNotificacion("Archivo HTML independiente del simulador descargado.", "exito");
    }

    function descargarArchivo(contenido, nombreArchivo, mimeType) {
      const blob = new Blob([contenido], { type: mimeType });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = nombreArchivo;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }
  </script>
</body>
</html>
